<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>NoLockWallpaper</string>
	<key>items</key>
	<array>

		<!-- ============================================================
		     组 0：总开关（2.0-1 新增）
		     ★ 为什么单独一组：1.9-1 及以前「禁用锁屏长按换壁纸」被当成了
		       事实上的总开关（源码里所有判据都带 gEnabled），用户关掉它，
		       后面的相机/手电筒三项一起失效。这是设计缺陷。
		       现在总开关独立成项，与任何具体功能都不共用。
		     ============================================================ -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>总开关</string>
			<key>footerText</key>
			<string>关掉这一项，下面所有开关都不再生效（插件完全不动手），下面各项的开关状态会被保留，重新打开总开关即恢复。</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用 NoLockWallpaper</string>
			<key>defaults</key>
			<string>com.liehuu.nolockwallpaper</string>
			<key>key</key>
			<string>MasterEnabled</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.liehuu.nolockwallpaper/changed</string>
		</dict>

		<!-- ============================================================
		     组 1：功能开关
		     ★ defaults 必须与 Tweak.m 的 NLWPrefsDomain 完全一致，
		       否则开关写到一个域、插件读另一个域 → 开关完全无效。
		     ★ key 必须与 Tweak.m 的 NLWEnabledKey / NLWBlockCameraKey 一致。
		     ★ PostNotification 必须与 Tweak.m 的 NLWChangedNotification 一致
		       （插件靠它做「关掉即时生效」）。
		     ★ 2.0-1：「禁用锁屏长按换壁纸」只代表长按自己，
		       不再是总开关（总开关见上面组 0）。
		     ============================================================ -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>功能（四项互不影响）</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用锁屏长按换壁纸</string>
			<key>defaults</key>
			<string>com.liehuu.nolockwallpaper</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.liehuu.nolockwallpaper/changed</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用锁屏手电筒</string>
			<key>defaults</key>
			<string>com.liehuu.nolockwallpaper</string>
			<key>key</key>
			<string>BlockFlashlight</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.liehuu.nolockwallpaper/changed</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用锁屏相机按钮</string>
			<key>defaults</key>
			<string>com.liehuu.nolockwallpaper</string>
			<key>key</key>
			<string>BlockCameraButton</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.liehuu.nolockwallpaper/changed</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用锁屏左滑进相机</string>
			<key>defaults</key>
			<string>com.liehuu.nolockwallpaper</string>
			<key>key</key>
			<string>BlockCameraSwipe</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.liehuu.nolockwallpaper/changed</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>关于上面四项</string>
			<key>footerText</key>
			<string>四项各自独立，关掉哪一项只影响哪一项。&#10;&#10;唯一的例外是「左滑进相机」：它是系统级开关（告诉系统本机不支持锁屏相机），一旦打开，相机按钮即使不被禁用也无法使用。所以这一项打开时相机按钮会一起隐藏 —— 与其给一个按不动的按钮，不如不给。想只用按钮、不用左滑，请把「左滑」关掉再打开「相机按钮」。</string>
		</dict>

		<!-- ============================================================
		     组 2：生效说明
		     ★ 把「关掉立即生效 / 打开需要重启桌面」这个不对称性写清楚。
		       用户看不到这条，就会认为开关坏了。
		     ============================================================ -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>生效方式</string>
			<key>footerText</key>
			<string>关闭开关：立即生效，锁屏长按/左滑会马上恢复原样。&#10;打开开关：需要点下方「重启桌面」，因为锁屏页面此时已经建好了，插件只能等它下次重建时才能拦下。</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重启桌面</string>
			<key>action</key>
			<string>respring</string>
			<key>confirmation</key>
			<dict>
				<key>title</key>
				<string>重启桌面</string>
				<key>prompt</key>
				<string>桌面会短暂黑屏并自动恢复，期间不要操作手机。是否继续？</string>
				<key>okTitle</key>
				<string>重启</string>
				<key>cancelTitle</key>
				<string>取消</string>
			</dict>
		</dict>

		<!-- ============================================================
		     组 3：说明
		     ============================================================ -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>说明</string>
			<key>footerText</key>
			<string>不会影响：主屏图标长按、锁屏通知长按与左滑删除、上滑解锁、下拉通知中心。&#10;查看版本：设置 → 通用 → iPhone 储存空间 → NoLockWallpaper。</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>应急停用</string>
			<key>footerText</key>
			<string>如果设置打不开或桌面异常，用文件管理器创建空文件：&#10;/var/mobile/Library/Preferences/com.liehuu.nlw.disabled&#10;然后重启桌面，插件将完全不再动手。删掉该文件即恢复。</string>
		</dict>

	</array>
</dict>
</plist>